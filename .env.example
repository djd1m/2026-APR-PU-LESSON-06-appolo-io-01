# PostgreSQL container
POSTGRES_DB=salesradar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database (use "db" as host for Docker, "localhost" for local dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/salesradar

# JWT
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_TIMEOUT=30.0

# YooKassa (stub mode by default)
PAYMENTS_STUB=true
YOOKASSA_SHOP_ID=
YOOKASSA_API_KEY=

# App
APP_NAME=SalesRadar
APP_VERSION=1.0.0
DEBUG=true

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8001"]
